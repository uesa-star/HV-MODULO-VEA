{
  "rewrites": [
    { "source": "/index.html", "destination": "/api/app" },
    { "source": "/", "destination": "/api/app" },
    { "source": "/boletines", "destination": "/boletines.html" },
    { "source": "/boletines/", "destination": "/boletines.html" },
    { "source": "/boletines/([0-9]+)", "destination": "/api/boletines?i=$1" },
    { "source": "/api/alerts", "destination": "/api/vea-data?ruta=alerts" },
    { "source": "/api/vea-boletin", "destination": "/api/boletines" }
  ],
  "functions": {
    "api/app.js": { "includeFiles": "node_modules/modulo-vea/**" }
  },
  "headers": [
    {
      "source": "/login.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
