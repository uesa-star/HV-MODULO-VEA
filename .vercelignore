.github/
scripts/
sql/
supabase/
backups/
respaldo/

# Documentacion y notas internas
*.md

# Restos de pruebas y previsualizaciones
_test_*.html
_probe*.html
preview-*.html
BOLETIN_VEA_PREVIEW.html
REVISION_BOLETIN_V17.html
MOCKUP_*

# Artefactos
__pycache__/
*.pyc
requirements-sync.txt
